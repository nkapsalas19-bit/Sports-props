# SQLite by default. Swap for a Postgres URL in production if you like.
DATABASE_URL="file:./dev.db"

# Which odds/stats provider to use for the daily scan.
# "mock"        -> built-in synthetic data generator, works with zero setup, great for demos/dev.
# "the-odds-api" -> real live odds via https://the-odds-api.com (requires ODDS_API_KEY below).
ODDS_PROVIDER="mock"

# Required only when ODDS_PROVIDER=the-odds-api. Get a free/paid key at https://the-odds-api.com
# (free tier: 500 requests/month). This is what actually pulls real FanDuel/DraftKings/BetMGM/
# Caesars lines — The Odds API has commercial deals with those books and republishes their odds.
ODDS_API_KEY=""

# Optional: backfills real historical team performance (needed for the moneyline model) via
# https://api-sports.io. Only "api-sports" is supported today; leave both unset to run
# the-odds-api with odds only (picks will show low confidence with no history behind them).
STATS_PROVIDER=""
API_SPORTS_KEY=""
# Caps how many api-sports.io calls one scan will make, so a free-tier key (~100/day on most
# plans) never gets exhausted or blocked. Partial coverage beyond this cap, not an error.
API_SPORTS_MAX_CALLS="90"

# "Good odds" guardrail for the value engine: only surface picks whose American odds
# fall in this range (avoids absurd favorites and longshot junk).
GOOD_ODDS_MIN="-250"
GOOD_ODDS_MAX="250"

# Minimum modeled edge (modeled probability - implied probability), as a decimal, e.g. 0.04 = 4%.
MIN_EDGE="0.03"
