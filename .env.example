# SQLite by default. Swap for a Postgres URL in production if you like.
DATABASE_URL="file:./dev.db"

# Which odds/stats provider to use for the daily scan.
# "mock"        -> built-in synthetic data generator, works with zero setup, great for demos/dev.
# "the-odds-api" -> real live odds via https://the-odds-api.com (requires ODDS_API_KEY below).
ODDS_PROVIDER="mock"

# Required only when ODDS_PROVIDER=the-odds-api. Get a free/paid key at https://the-odds-api.com
ODDS_API_KEY=""

# "Good odds" guardrail for the value engine: only surface picks whose American odds
# fall in this range (avoids absurd favorites and longshot junk).
GOOD_ODDS_MIN="-250"
GOOD_ODDS_MAX="250"

# Minimum modeled edge (modeled probability - implied probability), as a decimal, e.g. 0.04 = 4%.
MIN_EDGE="0.03"
